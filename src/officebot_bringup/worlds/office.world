<?xml version="1.0"?>
<sdf version="1.9">
  <world name="office_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== BUDYNEK: 12m x 8m ===================== -->
    <!-- Korytarz poziomy: y -0.8..0.8, x -6..6
         Północ (y 0.8..4): Open Space | Sala konferencyjna | Kuchnia
         Południe (y -4..-0.8): Pokój socjalny | Serwerownia -->
    <model name="walls">
      <static>true</static>

      <!-- Ściany zewnętrzne -->
      <link name="north_wall">
        <pose>0 4 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>0 -4 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="west_wall">
        <pose>-6 0 1.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>8 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="east_wall">
        <pose>6 0 1.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>8 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>

      <!-- Ściana korytarza PÓŁNOC (y=0.8), z 3 drzwiami -->
      <link name="corridor_north_1">
        <pose>-5.125 0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.75 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.75 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>
      <link name="corridor_north_2">
        <pose>-1.875 0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.75 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.75 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>
      <link name="corridor_north_3">
        <pose>1.875 0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.75 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.75 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>
      <link name="corridor_north_4">
        <pose>5.125 0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.75 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.75 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>

      <!-- Ściana korytarza POŁUDNIE (y=-0.8), z 2 drzwiami -->
      <link name="corridor_south_1">
        <pose>-4.75 -0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>
      <link name="corridor_south_2">
        <pose>0 -0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>
      <link name="corridor_south_3">
        <pose>4.75 -0.8 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.9 0.9 1</ambient><diffuse>0.85 0.9 0.9 1</diffuse></material></visual>
      </link>

      <!-- Ściany działowe między pomieszczeniami (strona północna) -->
      <link name="wall_office_meeting">
        <pose>-1.5 2.4 1.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>3.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_meeting_kitchen">
        <pose>1.5 2.4 1.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>3.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>

      <!-- Ściana działowa strona południowa -->
      <link name="wall_break_server">
        <pose>0 -2.4 1.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>3.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>

    </model>

    <!-- ===================== OPEN SPACE (x -6..-1.5, y 0.8..4) ===================== -->
    <model name="desk_1"><static>true</static><pose>-5.3 3.3 0.375 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.2 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.75</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="chair_1"><static>true</static><pose>-5.3 2.7 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="desk_2"><static>true</static><pose>-3.75 3.3 0.375 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.2 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.75</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="chair_2"><static>true</static><pose>-3.75 2.7 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="desk_3"><static>true</static><pose>-2.2 3.3 0.375 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.2 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.75</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="chair_3"><static>true</static><pose>-2.2 2.7 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="bookshelf"><static>true</static><pose>-5.3 1.2 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 0.35 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.35 1.8</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual></link>
    </model>

    <!-- ===================== SALA KONFERENCYJNA (x -1.5..1.5, y 0.8..4) ===================== -->
    <model name="meeting_table"><static>true</static><pose>0 2.4 0.375 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.8 1.0 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 1.0 0.75</size></box></geometry><material><ambient>0.5 0.3 0.15 1</ambient><diffuse>0.5 0.3 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="meeting_chair_1"><static>true</static><pose>0 3.1 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="meeting_chair_2"><static>true</static><pose>0 1.7 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="meeting_chair_3"><static>true</static><pose>-1.1 2.4 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="meeting_chair_4"><static>true</static><pose>1.1 2.4 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>

    <!-- ===================== KUCHNIA (x 1.5..6, y 0.8..4) ===================== -->
    <model name="kitchen_table"><static>true</static><pose>3.75 3.2 0.375 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 1.0 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 0.75</size></box></geometry><material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual></link>
    </model>
    <model name="kitchen_chair_1"><static>true</static><pose>3.15 3.2 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="kitchen_chair_2"><static>true</static><pose>4.35 3.2 0.225 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="kitchen_counter"><static>true</static><pose>5.3 1.3 0.45 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 1.0 0.9</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link>
    </model>

    <!-- ===================== POKÓJ SOCJALNY (x -6..0, y -4..-0.8) ===================== -->
    <model name="sofa"><static>true</static><pose>-5.0 -2.4 0.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.8 0.7 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.7 0.5</size></box></geometry><material><ambient>0.3 0.4 0.5 1</ambient><diffuse>0.3 0.4 0.5 1</diffuse></material></visual></link>
    </model>
    <model name="coffee_table"><static>true</static><pose>-3.6 -2.4 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.4</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="vending_machine"><static>true</static><pose>-0.6 -1.2 0.6 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.7 0.7 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 1.2</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- ===================== SERWEROWNIA (x 0..6, y -4..-0.8) ===================== -->
    <model name="server_rack_1"><static>true</static><pose>0.8 -3.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="server_rack_2"><static>true</static><pose>1.8 -3.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="server_rack_3"><static>true</static><pose>2.8 -3.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="server_rack_4"><static>true</static><pose>3.8 -3.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
    </model>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

  </world>
</sdf>
