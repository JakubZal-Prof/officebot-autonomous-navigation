<?xml version="1.0"?>
<robot name="officebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find officebot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find officebot_description)/urdf/officebot.gazebo.xacro"/>
  <xacro:include filename="$(find officebot_description)/urdf/officebot.ros2_control.xacro"/>

  <!-- ===================== PARAMETRY GEOMETRII ===================== -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width" value="0.30"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="8.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="wheel_x_offset" value="0.0"/>

  <xacro:property name="caster_radius" value="0.03"/>

  <!-- ===================== BASE FOOTPRINT / BASE LINK ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="office_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass/12.0 * (base_width*base_width + base_height*base_height)}" ixy="0" ixz="0"
        iyy="${base_mass/12.0 * (base_length*base_length + base_height*base_height)}" iyz="0"
        izz="${base_mass/12.0 * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- ===================== MAKRO: KOŁO ===================== -->
  <xacro:macro name="wheel_link" params="prefix">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" iyz="0"
          izz="${wheel_mass/2.0 * wheel_radius*wheel_radius}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel_link prefix="left"/>
  <xacro:wheel_link prefix="right"/>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_x_offset} ${wheel_separation/2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_x_offset} -${wheel_separation/2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== CASTER (kółko podporowe) ===================== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="office_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-${base_length/2.0 - caster_radius} 0 -${wheel_radius - caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="office_dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${base_length/2.0 - 0.05} 0 ${base_height/2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== KAMERA ===================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.02"/></geometry>
      <material name="office_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
  </joint>

</robot>
